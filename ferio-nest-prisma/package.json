{
  "name": "ferio-nest-prisma",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && nest build common && nest build database && nest build redis && nest build queue",
    "prisma:schema:build": "node prisma/scripts/build-prisma-schemaV2.js",
    "prisma:generate": "pnpm prisma generate --schema prisma/schema.prisma",
    "prisma:sync": "pnpm run prisma:schema:build && pnpm run prisma:generate",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:migrate:dev": "pnpm run prisma:schema:build && pnpm prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:status": "pnpm prisma migrate status --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "pnpm prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:control:generate": "pnpm prisma generate --config prisma/control-plane/prisma.config.ts",
    "prisma:control:push": "pnpm prisma db push --config prisma/control-plane/prisma.config.ts",
    "prisma:marketplace:generate": "pnpm prisma generate --config prisma/marketplace/prisma.config.ts",
    "prisma:marketplace:push": "pnpm prisma db push --config prisma/marketplace/prisma.config.ts",
    "prisma:marketplace:sql": "ts-node prisma/scripts/apply-marketplace-sql.ts",
    "prisma:tenant:generate": "pnpm prisma generate --config prisma/tenant/prisma.config.ts",
    "prisma:tenant:push": "pnpm prisma db push --config prisma/tenant/prisma.config.ts",
    "prisma:platform:generate": "pnpm run prisma:control:generate && pnpm run prisma:marketplace:generate && pnpm run prisma:tenant:generate",
    "prisma:platform:push": "pnpm run prisma:control:push && pnpm run prisma:marketplace:push && pnpm run prisma:tenant:push",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:de": "nest build common && nest build database && nest build redis && nest build queue && nest start -b swc --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:queue-smoke": "jest --config ./test/jest-queue-smoke.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "mongoose": "^9.6.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/../libs/$1/src"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
