#================================================================
# Ferio Commerce API - Environment Template
# Copy this file to .env and fill in your values
#================================================================

#───────────────────────────────────────────────────────────────
# Application Settings
#───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=6733
API_PREFIX=api/v1

#───────────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL)
#───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ferio

#───────────────────────────────────────────────────────────────
# Redis Configuration
#───────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#───────────────────────────────────────────────────────────────
# JWT Configuration
# ⚠️ SECURITY: Generate strong random secrets!
# Use: openssl rand -hex 32
#───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-64-character-random-string-here
ANALYTICS_HASH_SECRET=replace-with-a-separate-64-character-random-string
JWT_REFRESH_SECRET=your-another-64-character-random-string-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

#───────────────────────────────────────────────────────────────
# OTP Configuration
#───────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_WINDOW_MINUTES=3

#───────────────────────────────────────────────────────────────
# Bcrypt Configuration
#───────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

#───────────────────────────────────────────────────────────────
# SMTP Email Configuration
#───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ferio.shop

#───────────────────────────────────────────────────────────────
# OAuth Configuration
#───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:6733/api/v1/auth/google/callback

APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./path/to/apple-private-key.p8
APPLE_CALLBACK_URL=http://localhost:6733/api/v1/auth/apple/callback

#───────────────────────────────────────────────────────────────
# Client URLs (CORS)
#───────────────────────────────────────────────────────────────
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

#───────────────────────────────────────────────────────────────
# Initial Admin Seed
#───────────────────────────────────────────────────────────────
ADMIN_NAME=Ferio Admin
ADMIN_EMAIL=admin@ferio.shop
ADMIN_PASSWORD=replace-with-a-strong-password

#───────────────────────────────────────────────────────────────
# Courier Providers (optional; providers stay disabled without credentials)
# Secrets remain in environment/secret management, never PostgreSQL.
#───────────────────────────────────────────────────────────────
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=

PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=

REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_TOKEN=
REDX_WEBHOOK_SECRET=

PAPERFLY_BASE_URL=https://api.paperfly.com.bd
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_KEY=
PAPERFLY_STORE_NAME=Ferio E-Commerce
PAPERFLY_WEBHOOK_SECRET=

ECOURIER_BASE_URL=https://backoffice.ecourier.com.bd/api
ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
ECOURIER_WEBHOOK_SECRET=

CARRYBEE_BASE_URL=https://developers.carrybee.com
CARRYBEE_CLIENT_ID=
CARRYBEE_CLIENT_SECRET=
CARRYBEE_CLIENT_CONTEXT=
CARRYBEE_WEBHOOK_SECRET=

COURIER_CALLBACK_RETRY_ENABLED=false
COURIER_CALLBACK_RETRY_EVERY_MINUTES=5
COURIER_CALLBACK_RETRY_MAX_ATTEMPTS=6

#───────────────────────────────────────────────────────────────
# Stripe Configuration
#───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Hosted prepaid payments. Keep CommerceSettings.prepaidEnabled=false until
# sandbox callbacks and credentials are verified for at least one provider.
PUBLIC_API_URL=http://localhost:6733
CUSTOMER_WEB_URL=http://localhost:3000
PAYMENT_FALLBACK_EMAIL=payments@example.com
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
PAYMENT_RECOVERY_ENABLED=false
PAYMENT_RECOVERY_EVERY_MINUTES=5
PAYMENT_RECOVERY_BATCH_SIZE=100

#───────────────────────────────────────────────────────────────
# File Upload Configuration (Strategy Pattern)
#───────────────────────────────────────────────────────────────
# Choose upload strategy: cloudinary, s3, or digitalocean
FILE_UPLOAD_STRATEGY=cloudinary

# Cloudinary Configuration (if using Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# S3/DigitalOcean Configuration (if using S3 or DigitalOcean Spaces)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=your-bucket-name

# For DigitalOcean Spaces:
# AWS_REGION=nyc3
# AWS_BUCKET_NAME=your-space-name
# Uncomment endpoint in s3.strategy.ts if using DigitalOcean

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=./uploads/temp

#───────────────────────────────────────────────────────────────
# Rate Limiting Configuration
#───────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

#───────────────────────────────────────────────────────────────
# BullMQ Queue Configuration
# Redis 6.2 or newer is required for supported BullMQ operation.
#───────────────────────────────────────────────────────────────
QUEUE_PREFIX=bullmq
QUEUE_CONCURRENCY=10
RECONCILIATION_SCHEDULE_ENABLED=false
RECONCILIATION_SCHEDULE_EVERY_MINUTES=60
RECONCILIATION_OVERDUE_HOURS=168
COURIER_POLLING_ENABLED=false
COURIER_POLLING_EVERY_MINUTES=15
COURIER_POLLING_BATCH_SIZE=100
TRANSACTIONAL_MESSAGE_DISPATCH_ENABLED=false
TRANSACTIONAL_MESSAGE_SWEEP_EVERY_MINUTES=5
TRANSACTIONAL_MESSAGE_BATCH_SIZE=100

#───────────────────────────────────────────────────────────────
# Logging Configuration
#───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# Admin two-factor authentication (use independent high-entropy values)
TWO_FACTOR_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
TWO_FACTOR_CHALLENGE_SECRET=replace-with-a-separate-random-jwt-secret
TWO_FACTOR_ISSUER=Ferio Admin

# Deterministic Release 1 checkout coupons. Money values use poisha.
CHECKOUT_COUPONS_JSON=[]
ABANDONED_CART_MIN_AGE_HOURS=2
MARKETING_CONSENT_MAX_AGE_DAYS=365

#───────────────────────────────────────────────────────────────
# Health Check Configuration
#───────────────────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Deployment-reported backup evidence shown in the permission-protected Admin
# System Health workspace. These values do not run backups; deployment
# automation must update the timestamps only after verified success.
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_LAST_SUCCESS_AT=
OBJECT_STORAGE_PROTECTION_ENABLED=false
DATABASE_RESTORE_LAST_VERIFIED_AT=
