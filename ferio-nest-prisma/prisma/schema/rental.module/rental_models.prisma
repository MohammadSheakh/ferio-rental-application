// Source: rental.module/rental_models.prisma

model RentalOrganization {
  id            String              @id @default(uuid())
  name          String
  code          String              @unique
  status        RentalOrgStatus     @default(ACTIVE)
  currency      String              @default("BDT")
  timezone      String              @default("Asia/Dhaka")
  locale        String              @default("bn-BD")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  members       RentalOrganizationMember[]
  roles         RentalRole[]
  delegations   RentalDelegation[]
  people        RentalPerson[]
  portfolios    RentalPortfolio[]
  properties    RentalProperty[]
  leads         RentalLead[]
  applications  RentalApplication[]
  leases        RentalLease[]
  billingAccounts RentalBillingAccount[]
  invoices      RentalInvoice[]
  payments      RentalPayment[]
  ledgerEntries RentalLedgerEntry[]
  maintenanceRequests RentalMaintenanceRequest[]
  vendors       RentalVendorProfile[]
  documents     RentalDocument[]
  auditEvents   RentalAuditEvent[]

  @@map("rental_organizations")
}

model RentalOrganizationMember {
  id             String             @id @default(uuid())
  organizationId String
  userId         String
  roleId         String?
  status         RentalMemberStatus @default(ACTIVE)
  invitedAt      DateTime           @default(now())
  joinedAt       DateTime?

  organization   RentalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           RentalRole?        @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("rental_organization_members")
}

model RentalRole {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   RentalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        RentalOrganizationMember[]
  permissions    RentalRolePermission[]

  @@unique([organizationId, name])
  @@map("rental_roles")
}

model RentalPermission {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  module      String
  description String?

  roles       RentalRolePermission[]

  @@map("rental_permissions")
}

model RentalRolePermission {
  roleId       String
  permissionId String

  role         RentalRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   RentalPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("rental_role_permissions")
}

model RentalDelegation {
  id             String                 @id @default(uuid())
  organizationId String
  grantorUserId  String
  granteeUserId  String
  propertyId     String?
  buildingId     String?
  permissions    String[]
  effectiveFrom  DateTime
  effectiveTo    DateTime
  status         RentalDelegationStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())

  organization   RentalOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantorUser    User                   @relation("GrantorUser", fields: [grantorUserId], references: [id], onDelete: Cascade)
  granteeUser    User                   @relation("GranteeUser", fields: [granteeUserId], references: [id], onDelete: Cascade)
  property       RentalProperty?        @relation(fields: [propertyId], references: [id])
  building       RentalBuilding?        @relation(fields: [buildingId], references: [id])

  @@map("rental_delegations")
}

model RentalPerson {
  id               String               @id @default(uuid())
  organizationId   String
  firstName        String
  lastName         String
  email            String?
  phone            String
  nidPassport      String?
  permanentAddress String?
  emergencyContact String?
  avatarUrl        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerProfile     RentalOwnerProfile?
  leads            RentalLead[]
  applications     RentalApplication[]  @relation("ApplicantPerson")
  guarantors       RentalGuarantor[]
  leaseParties     RentalLeaseParty[]
  collectedPayments RentalPayment[]     @relation("CollectorPerson")

  @@unique([organizationId, phone])
  @@map("rental_people")
}

model RentalOwnerProfile {
  id             String               @id @default(uuid())
  personId       String               @unique
  ownerType      RentalOwnerType      @default(INDIVIDUAL)
  companyName    String?
  taxId          String?
  bankName       String?
  bankAccountNo  String?
  routingNo      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  person         RentalPerson         @relation(fields: [personId], references: [id], onDelete: Cascade)
  ownerships     RentalPropertyOwnership[]

  @@map("rental_owner_profiles")
}

model RentalPropertyOwnership {
  id                   String             @id @default(uuid())
  propertyId           String
  ownerProfileId       String
  ownershipPercentage  Float
  effectiveFrom        DateTime           @default(now())
  effectiveTo          DateTime?
  isPrimaryContact     Boolean            @default(false)

  property             RentalProperty     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerProfile         RentalOwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  @@map("rental_property_ownerships")
}

model RentalPortfolio {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     RentalProperty[]

  @@map("rental_portfolios")
}

model RentalProperty {
  id             String               @id @default(uuid())
  organizationId String
  portfolioId    String?
  name           String
  code           String
  propertyType   RentalPropertyType
  address        String
  district       String
  area           String
  latitude       Float?
  longitude      Float?
  status         RentalPropertyStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio      RentalPortfolio?     @relation(fields: [portfolioId], references: [id])
  ownerships     RentalPropertyOwnership[]
  buildings      RentalBuilding[]
  units          RentalUnit[]
  delegations    RentalDelegation[]
  maintenanceRequests RentalMaintenanceRequest[]

  @@unique([organizationId, code])
  @@map("rental_properties")
}

model RentalBuilding {
  id               String               @id @default(uuid())
  propertyId       String
  name             String
  buildingNumber   String?
  floors           Int                  @default(1)
  constructionYear Int?
  liftCount        Int                  @default(0)
  parkingCount     Int                  @default(0)
  status           RentalPropertyStatus @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  property         RentalProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units            RentalUnit[]
  delegations      RentalDelegation[]

  @@map("rental_buildings")
}

model RentalUnit {
  id             String               @id @default(uuid())
  propertyId     String
  buildingId     String?
  unitNumber     String
  floor          Int?
  unitType       RentalUnitType
  bedrooms       Int?
  bathrooms      Int?
  balconies      Int?
  areaSqFt       Float?
  marketRent     Decimal              @db.Decimal(12, 2)
  targetRent     Decimal?             @db.Decimal(12, 2)
  status         RentalUnitStatus     @default(AVAILABLE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  property       RentalProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building       RentalBuilding?      @relation(fields: [buildingId], references: [id])
  leads          RentalLead[]
  viewings       RentalViewing[]
  applications   RentalApplication[]
  leases         RentalLease[]
  billingAccounts RentalBillingAccount[]
  maintenanceRequests RentalMaintenanceRequest[]

  @@unique([propertyId, unitNumber])
  @@map("rental_units")
}

model RentalLead {
  id               String               @id @default(uuid())
  organizationId   String
  interestedUnitId String?
  personId         String
  source           RentalLeadSource     @default(WALK_IN)
  sourceAgentId    String?
  budgetMin        Decimal?             @db.Decimal(12, 2)
  budgetMax        Decimal?             @db.Decimal(12, 2)
  expectedMoveIn   DateTime?
  familySize       Int?
  occupation       String?
  status           RentalLeadStatus     @default(NEW)
  assignedUserId   String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interestedUnit   RentalUnit?          @relation(fields: [interestedUnitId], references: [id])
  person           RentalPerson         @relation(fields: [personId], references: [id], onDelete: Cascade)
  viewings         RentalViewing[]

  @@map("rental_leads")
}

model RentalViewing {
  id             String               @id @default(uuid())
  leadId         String
  unitId         String
  assignedUserId String?
  scheduledAt    DateTime
  completedAt    DateTime?
  status         RentalViewingStatus  @default(SCHEDULED)
  feedback       String?
  interestLevel  Int?                 @default(3)

  lead           RentalLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit           RentalUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("rental_viewings")
}

model RentalApplication {
  id                   String                  @id @default(uuid())
  organizationId       String
  unitId               String
  applicantPersonId    String
  offeredRent          Decimal                 @db.Decimal(12, 2)
  expectedMoveIn       DateTime
  occupation           String?
  employer             String?
  monthlyIncome        Decimal?                @db.Decimal(12, 2)
  previousLandlordName String?
  previousLandlordPhone String?
  status               RentalApplicationStatus @default(SUBMITTED)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization         RentalOrganization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit                 RentalUnit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applicantPerson      RentalPerson            @relation("ApplicantPerson", fields: [applicantPersonId], references: [id], onDelete: Cascade)
  guarantors           RentalGuarantor[]
  verifications        RentalVerificationChecklist[]
  leases               RentalLease[]

  @@map("rental_applications")
}

model RentalGuarantor {
  id                 String              @id @default(uuid())
  applicationId      String?
  leaseId            String?
  personId           String
  relationship       String
  guarantorType      RentalGuarantorType @default(FAMILY)
  incomeProofUrl     String?
  verified           Boolean             @default(false)
  verifiedAt         DateTime?
  verifiedByUserId   String?

  application        RentalApplication?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lease              RentalLease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  person             RentalPerson        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("rental_guarantors")
}

model RentalVerificationChecklist {
  id               String                   @id @default(uuid())
  applicationId    String
  verificationType RentalVerificationType
  status           RentalVerificationStatus @default(PENDING)
  verifiedByUserId String?
  verifiedAt       DateTime?
  notes            String?

  application      RentalApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("rental_verification_checklists")
}

model RentalLease {
  id               String                 @id @default(uuid())
  organizationId   String
  unitId           String
  applicationId    String?
  leaseNumber      String                 @unique
  startDate        DateTime
  endDate          DateTime
  rentAmount       Decimal                @db.Decimal(12, 2)
  serviceCharge    Decimal                @default(0.00) @db.Decimal(12, 2)
  securityDeposit  Decimal                @default(0.00) @db.Decimal(12, 2)
  billingFrequency RentalBillingFrequency @default(MONTHLY)
  dueDay           Int                    @default(5)
  gracePeriodDays  Int                    @default(5)
  noticePeriodDays Int                    @default(30)
  renewalPolicy    String                 @default("MANUAL")
  status           RentalLeaseStatus      @default(DRAFT)
  signedAt         DateTime?
  activatedAt      DateTime?
  terminatedAt     DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization     RentalOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit             RentalUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  application      RentalApplication?     @relation(fields: [applicationId], references: [id])
  parties          RentalLeaseParty[]
  guarantors       RentalGuarantor[]
  billingAccounts  RentalBillingAccount[]
  depositAccounts  RentalDepositAccount[]

  @@map("rental_leases")
}

model RentalLeaseParty {
  id                       String               @id @default(uuid())
  leaseId                  String
  personId                 String
  role                     RentalLeasePartyRole @default(PRIMARY_TENANT)
  financiallyResponsible   Boolean              @default(true)
  isOccupant               Boolean              @default(true)

  lease                    RentalLease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  person                   RentalPerson         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([leaseId, personId])
  @@map("rental_lease_parties")
}

model RentalBillingAccount {
  id             String                     @id @default(uuid())
  organizationId String
  leaseId        String
  unitId         String
  currency       String                     @default("BDT")
  balance        Decimal                    @default(0.00) @db.Decimal(12, 2)
  status         RentalBillingAccountStatus @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization   RentalOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease          RentalLease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  unit           RentalUnit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  recurringRules RentalRecurringChargeRule[]
  invoices       RentalInvoice[]
  payments       RentalPayment[]
  ledgerEntries  RentalLedgerEntry[]

  @@map("rental_billing_accounts")
}

model RentalRecurringChargeRule {
  id               String               @id @default(uuid())
  billingAccountId String
  chargeType       RentalChargeCategory @default(RENT)
  description      String
  amount           Decimal              @db.Decimal(12, 2)
  frequency        RentalBillingFrequency @default(MONTHLY)
  dueDay           Int                  @default(5)
  isActive         Boolean              @default(true)

  billingAccount   RentalBillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("rental_recurring_charge_rules")
}

model RentalInvoice {
  id               String               @id @default(uuid())
  organizationId   String
  billingAccountId String
  invoiceNumber    String               @unique
  period           String
  issueDate        DateTime             @default(now())
  dueDate          DateTime
  gracePeriodEnd   DateTime
  subtotal         Decimal              @db.Decimal(12, 2)
  serviceCharge    Decimal              @default(0.00) @db.Decimal(12, 2)
  utilityShare     Decimal              @default(0.00) @db.Decimal(12, 2)
  adjustments      Decimal              @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal              @db.Decimal(12, 2)
  paidAmount       Decimal              @default(0.00) @db.Decimal(12, 2)
  balanceDue       Decimal              @db.Decimal(12, 2)
  status           RentalInvoiceStatus  @default(ISSUED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount   RentalBillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  lines            RentalInvoiceLine[]
  allocations      RentalPaymentAllocation[]

  @@map("rental_invoices")
}

model RentalInvoiceLine {
  id             String               @id @default(uuid())
  invoiceId      String
  chargeCategory RentalChargeCategory
  description    String
  amount         Decimal              @db.Decimal(12, 2)

  invoice        RentalInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("rental_invoice_lines")
}

model RentalPayment {
  id                 String                       @id @default(uuid())
  organizationId     String
  billingAccountId   String
  paymentNumber      String                       @unique
  amount             Decimal                      @db.Decimal(12, 2)
  paymentMethod      RentalPaymentMethod
  providerReference  String?
  paidAt             DateTime                     @default(now())
  recordedByUserId   String
  collectorPersonId  String?
  proofUrl           String?
  verificationStatus RentalCashVerificationStatus @default(VERIFIED)
  createdAt          DateTime                     @default(now())

  organization       RentalOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount     RentalBillingAccount         @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  collectorPerson    RentalPerson?                @relation("CollectorPerson", fields: [collectorPersonId], references: [id])
  allocations        RentalPaymentAllocation[]

  @@map("rental_payments")
}

model RentalPaymentAllocation {
  id              String        @id @default(uuid())
  paymentId       String
  invoiceId       String
  allocatedAmount Decimal       @db.Decimal(12, 2)

  payment         RentalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice         RentalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("rental_payment_allocations")
}

model RentalLedgerEntry {
  id               String                      @id @default(uuid())
  organizationId   String
  billingAccountId String
  transactionType  RentalLedgerTransactionType
  debit            Decimal                     @default(0.00) @db.Decimal(12, 2)
  credit           Decimal                     @default(0.00) @db.Decimal(12, 2)
  balanceAfter     Decimal                     @db.Decimal(12, 2)
  referenceType    String
  referenceId      String
  description      String
  occurredAt       DateTime                    @default(now())
  createdAt        DateTime                    @default(now())

  organization     RentalOrganization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount   RentalBillingAccount        @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("rental_ledger_entries")
}

model RentalDepositAccount {
  id             String                     @id @default(uuid())
  leaseId        String
  requiredAmount Decimal                    @db.Decimal(12, 2)
  heldAmount     Decimal                    @default(0.00) @db.Decimal(12, 2)
  status         RentalDepositStatus        @default(HELD)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  lease          RentalLease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  transactions   RentalDepositTransaction[]

  @@map("rental_deposit_accounts")
}

model RentalDepositTransaction {
  id               String               @id @default(uuid())
  depositAccountId String
  transactionType  RentalDepositTxType
  amount           Decimal              @db.Decimal(12, 2)
  notes            String?
  approvedByUserId String?
  createdAt        DateTime             @default(now())

  depositAccount   RentalDepositAccount @relation(fields: [depositAccountId], references: [id], onDelete: Cascade)

  @@map("rental_deposit_transactions")
}

model RentalMaintenanceRequest {
  id                 String                    @id @default(uuid())
  organizationId     String
  propertyId         String
  unitId             String
  reporterPersonId   String
  category           RentalMaintenanceCategory
  urgency            RentalMaintenanceUrgency  @default(NORMAL)
  description        String
  photos             String[]
  whatsappMessageId  String?
  status             RentalMaintenanceStatus   @default(OPEN)
  assignedStaffUserId String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  organization       RentalOrganization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property           RentalProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit               RentalUnit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  workOrders         RentalWorkOrder[]

  @@map("rental_maintenance_requests")
}

model RentalVendorProfile {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  specialty      String
  phone          String
  email          String?
  rating         Float?               @default(5.0)
  createdAt      DateTime             @default(now())

  organization   RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrders     RentalWorkOrder[]

  @@map("rental_vendor_profiles")
}

model RentalWorkOrder {
  id            String                 @id @default(uuid())
  requestId     String
  vendorId      String
  estimatedCost Decimal?               @db.Decimal(12, 2)
  actualCost    Decimal?               @db.Decimal(12, 2)
  scheduledDate DateTime?
  completedDate DateTime?
  status        RentalWorkOrderStatus  @default(ASSIGNED)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  request       RentalMaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor        RentalVendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("rental_work_orders")
}

model RentalDocument {
  id               String                 @id @default(uuid())
  organizationId   String
  resourceType     String
  resourceId       String
  category         RentalDocumentCategory
  documentType     String
  fileName         String
  fileUrl          String
  fileSize         Int
  uploadedByUserId String
  accessLevel      String                 @default("PRIVATE")
  createdAt        DateTime               @default(now())

  organization     RentalOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("rental_documents")
}

model RentalAuditEvent {
  id             String               @id @default(uuid())
  organizationId String
  actorUserId    String
  action         String
  resourceType   String
  resourceId     String
  beforeState    Json?
  afterState     Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime             @default(now())

  organization   RentalOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("rental_audit_events")
}
