// Source: base/datasource.prisma
// Prisma datasource configuration.
// This file only describes which database Prisma connects to.
// All models are kept in module folders and combined into prisma/schema.prisma by the build script.
datasource db {
  provider = "postgresql" // Change to "mongodb" only if the schema is converted to Mongo ObjectId style.
}


// Source: base/generator.prisma
// Prisma Client generator.
// Run the schema builder first, then run prisma generate against prisma/schema.prisma.
generator client {
  provider = "prisma-client-js"
  // output   = "../../generated/prisma"
}


// Source: shared/attachment.prisma
enum AttachmentType {
  document
  image
  video
  unknown
}

model Attachment {
  id             String         @id @default(cuid())
  attachment     String
  attachmentType AttachmentType
  publicId       String?
  originalName   String?
  size           Int?
  mimeType       String?

  // 🔗 Polymorphic target: one attachment can point to a task, user, message, etc.
  attachedToType String?
  attachedToId   String?

  // 🔗 Many to One: one message can have many attachments
  message   Message? @relation(fields: [messageId], references: [id])
  messageId String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attachedToType, attachedToId, isDeleted])
  @@index([attachmentType, isDeleted])
  @@index([createdAt, isDeleted])
}


