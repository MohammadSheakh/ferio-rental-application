// Source: chatting.module/conversation.prisma
enum ConversationType {
  direct
  group
}

enum ParticipantRole {
  admin
  member
}

model Conversation {
  id                   String   @id @default(cuid())

  // 🔗 Many conversations can be created by one user.
  creatorId            String
  creator              User     @relation("ConversationCreator", fields: [creatorId], references: [id])

  type                 ConversationType
  groupName            String?
  groupProfilePicture  String?

  // Last message snapshot for faster conversation list loading.
  lastMessageId        String?
  lastMessageText      String?
  lastMessageCreatedAt DateTime?
  isDeleted            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 🔗 One conversation can have many participants.
  participants ConversationParticipents[]

  // 🔗 One conversation can have many messages.
  messages     Message[]

  // 🔗 One conversation can have many read-status rows.
  readStatuses MessageReadStatus[]


  @@index([creatorId, isDeleted])
  @@index([type, isDeleted])
  @@index([lastMessageCreatedAt, isDeleted])
}


// Source: chatting.module/conversationParticipents.prisma
model ConversationParticipents {
  id                         String          @id @default(cuid())

  // 🔗 Many participant rows can belong to one user.
  userId                     String
  user                       User            @relation(fields: [userId], references: [id])
  userName                   String

  // 🔗 Many participant rows can belong to one conversation.
  conversationId             String
  conversation               Conversation    @relation(fields: [conversationId], references: [id])
  joinedAt                   DateTime        @default(now())
  role                       ParticipantRole
  lastMessageReadAt          DateTime?
  lastMessageReadId          String?
  unreadCount                Int             @default(0)
  isThisConversationUnseen   Int             @default(0)
  isDeleted                  Boolean         @default(false)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([userId, conversationId, isDeleted])
  @@index([conversationId, isDeleted])
  @@index([userId, isDeleted])
}


// Source: chatting.module/message.prisma
model Message {
  id             String       @id @default(cuid())
  text           String

  // 🔗 Many messages can be sent by one user.
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  // 🔗 Many messages can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // 🔗 One-to-many: one message can include many attachments.
  attachments  Attachment[]

  // 🔗 One message can have many read-status rows, one per reader.
  readStatuses MessageReadStatus[]

  @@index([conversationId, createdAt, isDeleted])
  @@index([senderId, isDeleted])
  @@index([createdAt, isDeleted])
}


// Source: chatting.module/messageReadStatus.prisma
model MessageReadStatus {
  id             String       @id @default(cuid())

  // 🔗 Many read-status rows can belong to one message.
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id])

  // 🔗 Many read-status rows can belong to one user.
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // 🔗 Many read-status rows can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([messageId, userId])
  @@index([messageId, userId, isDeleted])
  @@index([conversationId, userId, isRead])
  @@index([userId, isRead])
}


// Source: notification.module/notification.prisma
enum NotificationType {
  task
  group
  system
  reminder
  mention
  assignment
  deadline
  custom
  commerce
  order
  payment
  wallet
  warranty
  service
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum NotificationStatus {
  pending
  sent
  delivered
  read
  failed
}

model Notification {
  id           String               @id @default(cuid())
  deduplicationKey String?          @unique

  // 🔗 Many notifications can be sent by one user.
  senderId     String?
  sender       User?                @relation("NotificationSender", fields: [senderId], references: [id])

  // 🔗 Many notifications can be received by one user.
  receiverId   String?
  receiver     User?                @relation("NotificationReceiver", fields: [receiverId], references: [id])

  // Role broadcast target when receiverId is empty.
  receiverRole String?
  type         NotificationType
  priority     NotificationPriority @default(normal)
  status       NotificationStatus   @default(pending)
  title        String
  message      String?
  // 🔗 Polymorphic target: notification can point to a task, group, message, etc.
  entityType   String?
  entityId     String?
  linkFor      String?
  linkId       String?
  data         Json?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  deliveredAt  DateTime?
  isDeleted    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([receiverId, isRead, isDeleted, createdAt])
  @@index([receiverId, status, isDeleted])
  @@index([senderId, isDeleted])
  @@index([type, isDeleted])
  @@index([entityType, entityId, isDeleted])
  @@index([receiverRole, isDeleted])
}

enum CommerceMessagePurpose {
  TRANSACTIONAL
  PROMOTIONAL
}

enum CommerceMessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum CommerceMessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  BLOCKED
}

enum CommerceMessageAttemptStatus {
  STARTED
  ACCEPTED
  DELIVERED
  FAILED
  UNKNOWN
}

model CommerceMessage {
  id               String                 @id @default(cuid())
  deduplicationKey String                 @unique
  eventType        String
  purpose          CommerceMessagePurpose @default(TRANSACTIONAL)
  templateKey      String
  templateVersion  Int
  renderedSubject  String?
  renderedBody     String
  recipient        String
  selectedChannel  CommerceMessageChannel?
  channelPlan      CommerceMessageChannel[]
  routingPolicyVersion Int?
  fallbackReason   String?
  terminalReason   String?
  status           CommerceMessageStatus  @default(QUEUED)
  referenceType    String
  referenceId      String
  payload           Json?
  availableAt      DateTime               @default(now())
  lockedAt         DateTime?
  sentAt           DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  completedAt      DateTime?
  lastError        String?
  attempts         CommerceMessageAttempt[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, availableAt])
  @@index([referenceType, referenceId, createdAt])
  @@index([recipient, createdAt])
  @@index([eventType, createdAt])
}

model CommerceMessageTemplate {
  key             String   @id
  eventType       String   @unique
  enabled         Boolean  @default(true)
  subjectTemplate String?
  bodyTemplate    String
  version         Int      @default(1)
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, eventType])
}

model CommerceMessagingPolicy {
  id                          String                   @id @default("transactional-default")
  enabled                     Boolean                  @default(false)
  version                     Int                      @default(1)
  channelPriority             CommerceMessageChannel[]
  fallbackOnDefinitiveFailure Boolean                  @default(true)
  updatedById                 String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
}

model CommerceMessageAttempt {
  id                String                       @id @default(cuid())
  attemptNumber     Int
  channel           CommerceMessageChannel
  provider          String
  status            CommerceMessageAttemptStatus @default(STARTED)
  providerMessageId String?
  requestPayload    Json?
  responsePayload   Json?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime                     @default(now())
  completedAt       DateTime?
  messageId         String
  message           CommerceMessage              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt         DateTime                     @default(now())

  @@unique([messageId, attemptNumber])
  @@index([status, createdAt])
  @@index([provider, providerMessageId])
}


